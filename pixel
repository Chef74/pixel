-- ══════════════════════════════════════════════════════
--  ZYNOVA COMPAT SHIM
--  Normalises the http function across executors so the
--  Rayfield fetch works regardless of engine quirks.
-- ══════════════════════════════════════════════════════
local function httpGet(url)
    -- Try each method in order of executor support
    local ok, result

    -- Method 1: standard Roblox (no boolean — Zynova dislikes it)
    ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and result and result ~= "" then return result end

    -- Method 2: syn.request (Synapse / some forks)
    if syn and syn.request then
        ok, result = pcall(function()
            return syn.request({ Url = url, Method = "GET" }).Body
        end)
        if ok and result and result ~= "" then return result end
    end

    -- Method 3: request() global (KRNL, Fluxus, some Zynova builds)
    if request then
        ok, result = pcall(function()
            return request({ Url = url, Method = "GET" }).Body
        end)
        if ok and result and result ~= "" then return result end
    end

    -- Method 4: http.request (older executor APIs)
    if http and http.request then
        ok, result = pcall(function()
            return http.request({ Url = url, Method = "GET" }).Body
        end)
        if ok and result and result ~= "" then return result end
    end

    error("[Axiom] All HTTP methods failed. Check your executor's HTTP toggle.")
end

