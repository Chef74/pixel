-- ══════════════════════════════════════════════════════
--  AUTO-DETECT LEADERSTATS
-- ══════════════════════════════════════════════════════
local moneyKeywords    = {"money","cash","gold","coin","dollar","bucks","credit","balance"}
local materialKeywords = {"material","wood","stone","iron","resource","ore","lumber","supply","mat"}
local nukeKeywords     = {"nuke","bomb","missile","rocket","warhead","weapon","explosive","blast"}

local function matchesKeywords(name, keywords)
    local lower = name:lower()
    for _, kw in ipairs(keywords) do
        if lower:find(kw, 1, true) then return true end
    end
    return false
end

local function findStat(keywords, override)
    local ls = lp:FindFirstChild("leaderstats")
    if not ls then return nil end
    if override and override ~= "" then
        return ls:FindFirstChild(override)
    end
    for _, obj in ipairs(ls:GetChildren()) do
        if (obj:IsA("NumberValue") or obj:IsA("IntValue"))
           and matchesKeywords(obj.Name, keywords) then
            return obj
        end
    end
    return nil
end

local statMoney, statMaterial, statNuke

local function refreshStats()
    statMoney    = findStat(moneyKeywords,    CONFIG.moneyStatName)
    statMaterial = findStat(materialKeywords, CONFIG.materialStatName)
    statNuke     = findStat(nukeKeywords,     CONFIG.nukeStatName)
end

-- Wait for leaderstats then scan
task.spawn(function()
    local deadline = tick() + 15
    while not lp:FindFirstChild("leaderstats") and tick() < deadline do
        task.wait(0.4)
    end
    refreshStats()
end)

lp.CharacterAdded:Connect(function()
    task.wait(1.5)
    refreshStats()
end)

-- ══════════════════════════════════════════════════════
--  RESOURCE SETTER  (pcall-wrapped for Zynova sandbox)
-- ══════════════════════════════════════════════════════
local loopFlags = { money = false, material = false, nuke = false }

local function setStat(stat, amount)
    if not stat or not stat.Parent then return end
    pcall(function() stat.Value = amount end)
end

-- Heartbeat loop — uses explicit service ref, not shorthand
RunService.Heartbeat:Connect(function()
    if loopFlags.money    then setStat(statMoney,    CONFIG.moneyAmount)    end
    if loopFlags.material then setStat(statMaterial, CONFIG.materialAmount) end
    if loopFlags.nuke     then setStat(statNuke,     CONFIG.nukeAmount)     end
end)

-- ══════════════════════════════════════════════════════
--  REMOTE UTILS
-- ══════════════════════════════════════════════════════
local function deepFind(root, nameList)
    for _, name in ipairs(nameList) do
        local r = root:FindFirstChild(name, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
            return r
        end
    end
    return nil
end

local function findNukeRemote()
    return deepFind(ReplicatedStorage, CONFIG.nukeRemoteNames)
        or deepFind(workspace,         CONFIG.nukeRemoteNames)
end

local function fireRemote(remote)
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer()
        else
            remote:InvokeServer()
        end
    end)
end

local function listAllRemotes()
    local lines = {}
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(lines, obj.Name .. "  [" .. obj.ClassName .. "]")
        end
    end
    return #lines > 0 and table.concat(lines, "\n") or "No remotes in ReplicatedStorage."
end

